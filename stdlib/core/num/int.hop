/// 64-bit signed integer
#export
type Int = intrinsic

/// The maximum possible value of an Int
#export
let MAX_VALUE = 9_223_372_036_854_775_807

/// The minimum possible value of an Int
// #export
// let MIN_VALUE = -9_223_372_036_854_775_808

/// Returns the maximum of two integers
let max = fun (a: Int, b: Int) -> Int {
    if a > b {
        a
    } else {
        b
    }
}

/// Returns the minimum of two integers
let min = fun (a: Int, b: Int) -> Int {
    if a < b {
        a
    } else {
        b
    }
}
