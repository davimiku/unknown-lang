/// A dynamically growable list of items. The list is homogenous, all items are of type 'A
#export
type List 'A = intrinsic

// maybe eventually like this so that more List operations can be in stdlib instead of native
//
// ```
// type List 'A = [ len: Int, cap: Int, items: intrinsic ]
// ```

/// Creates an empty list. Its element type is inferred from context.
#export
let list_new = intrinsic

/// Appends an element to a list.
#export
let list_push = intrinsic

/// Returns the number of elements in a list.
#export
let list_len = intrinsic
