// type Bool = @core/types/bool/Bool

/// A value that may or may not exist
#export
type Option 'A = none | some: 'A

#export
let map = fun ['A](opt: Option 'A, mapper: ('A) -> 'A) -> Option 'A {
    match opt {
        .none -> { Option.none }
        .some value -> { Option.some (mapper value) }
    }
}

