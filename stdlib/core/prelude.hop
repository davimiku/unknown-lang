// This prelude is a special module, the symbols defined here are
// automatically injected into all modules for symbol resolution

#export type Int = @core/math/int/Int

#export type Float = @core/math/float/Float

#export type String = @core/text/string/String

#export type List = @core/collections/list/List

// Bool re-exports
#export type Bool = @core/types/bool/Bool
#export let false = Bool.false
#export let true = Bool.true

